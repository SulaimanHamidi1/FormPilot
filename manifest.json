{
  "manifest_version": 3,
  "name": "FormPilot",
  "version": "1.1.0",
  "description": "Auto-fill job applications from a profile stored only on your device.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.myworkdaysite.com/*",
    "*://*.smartrecruiters.com/*",
    "*://*.icims.com/*",
    "*://*.jobvite.com/*",
    "*://*.workable.com/*",
    "*://*.bamboohr.com/*",
    "*://*.taleo.net/*",
    "*://*.successfactors.com/*",
    "*://*.successfactors.eu/*",
    "*://*.breezy.hr/*",
    "*://*.recruitee.com/*",
    "*://*.teamtailor.com/*",
    "*://*.applytojob.com/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "action": {
    "default_title": "FormPilot",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html",
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Fill the job application on this page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
